# Copy this file to secrets/env.sh and set your values.
# secrets/env.sh is gitignored and loaded by zsh via home.nix.
#
#   cp secrets/env.sh.example secrets/env.sh
#
# Do not commit secrets/env.sh.

export GITHUB_TOKEN="ghp_your_token_here"

# Used by the `push_gh` shell function (home.nix) for git push to GitHub over HTTPS.
# Username is always x-access-token; password is this PAT.
