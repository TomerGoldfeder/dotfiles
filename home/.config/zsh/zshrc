# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Source of truth: ~/.dotfiles/home/.config/zsh/zshrc

# Powerlevel10k (Homebrew formula)
if [[ -r "${HOMEBREW_PREFIX:-/opt/homebrew}/share/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/powerlevel10k/powerlevel10k.zsh-theme"
fi

# Source of truth: ~/.dotfiles/home/.config/zsh/p10k.zsh (symlinked as ~/.p10k.zsh)
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

. "$HOME/.atuin/bin/env"


source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# history setup
HISTFILE=$HOME/.zhistory
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

bindkey "^[[1;3D" backward-word
bindkey "^[[1;3C" forward-word
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
eval "$(atuin init zsh)"

eval "$(zoxide init zsh)"

# lincheney/fzf-tab-completion — Tab → fzf_completion against zsh completer
# Resolve from this file’s realpath so ~/.zshrc symlink works.
autoload -Uz compinit && compinit
_zsh_config_dir="${${(%):-%x}:A:h}"
source "${_zsh_config_dir}/fzf-tab-completion/zsh/fzf-zsh-completion.sh"
bindkey '^I' fzf_completion
unset _zsh_config_dir

# Must stay after zle widgets (fzf_completion, etc.)
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh


# yazi 
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}


# alias command
alias ls="eza --icons=always --color=always --long --git --no-filesize --no-user --no-permissions"
alias cd='z'
alias ca='cursor-agent --yolo'
alias cc='claude'
alias add='git add'
alias commit='git commit -m'
alias push='git push'
alias pull='git pull'
alias gd='git diff --name-only'
alias gco='git checkout'
alias hs='herdr session'
alias gpr='gh pr-tui'

alias update_stable_pointers='git fetch origin --tags --force'

