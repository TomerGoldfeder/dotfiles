# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Source of truth: ~/.dotfiles/home/.config/zsh/zshrc

# Machine-local environment variables (not in version control).
# ~/.env_vars is created by bootstrap.sh; drop one *.zsh file per concern.
for _env_file in "$HOME"/.env_vars/*.zsh(N); do
  source "$_env_file"
done
unset _env_file

# Powerlevel10k (Homebrew formula)
if [[ -r "${HOMEBREW_PREFIX:-/opt/homebrew}/share/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/powerlevel10k/powerlevel10k.zsh-theme"
fi

# Source of truth: ~/.dotfiles/home/.config/zsh/p10k.zsh (symlinked as ~/.p10k.zsh)
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# . "$HOME/.atuin/bin/env"


# Single compinit owner: must run before atuin, zoxide and fzf-tab-completion (they call compdef).
# Cached dump; full rebuild only when the dump is missing or older than 24h.
_zsh_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d "$_zsh_cache_dir" ]] || mkdir -p "$_zsh_cache_dir"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$_zsh_cache_dir"
autoload -Uz compinit
_zcompdump_stale=("$_zsh_cache_dir/zcompdump"(Nmh+24))
if [[ -f "$_zsh_cache_dir/zcompdump" && ${#_zcompdump_stale} -eq 0 ]]; then
  compinit -C -d "$_zsh_cache_dir/zcompdump"
else
  compinit -d "$_zsh_cache_dir/zcompdump"
  touch "$_zsh_cache_dir/zcompdump"
fi
unset _zsh_cache_dir _zcompdump_stale

# history setup
HISTFILE=$HOME/.zhistory
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

bindkey "^[[1;3D" backward-word
bindkey "^[[1;3C" forward-word
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
eval "$(atuin init zsh)"

eval "$(zoxide init zsh)"

# lincheney/fzf-tab-completion — Tab → fzf_completion against zsh completer
# Resolve from this file’s realpath so ~/.zshrc symlink works.
_zsh_config_dir="${${(%):-%x}:A:h}"
source "${_zsh_config_dir}/fzf-tab-completion/zsh/fzf-zsh-completion.sh"
bindkey '^I' fzf_completion
unset _zsh_config_dir

# zsh-autosuggestions: after atuin, zoxide and fzf_completion widgets exist, before syntax-highlighting.
export ZSH_AUTOSUGGEST_MANUAL_REBIND=1
export ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
export ZSH_AUTOSUGGEST_USE_ASYNC=1
source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Must stay last among plugins, after zle widgets (fzf_completion, etc.)
export ZSH_HIGHLIGHT_MAXLENGTH=300
source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"


# yazi 
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}


